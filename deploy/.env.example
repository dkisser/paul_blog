# ===== umami / PostgreSQL 环境变量（deploy/docker-compose.yml 的 env_file）=====
# 复制为 deploy/.env 后填入真实值；deploy/.env 不要提交到任何仓库

# PostgreSQL
POSTGRES_DB=umami
POSTGRES_USER=umami
# TODO: 替换为强密码（例如 openssl rand -hex 24）
POSTGRES_PASSWORD=change-me-strong-password

# umami 连接串（用户/密码须与上面一致；db 为 compose 服务名，不要改）
DATABASE_URL=postgresql://umami:change-me-strong-password@db:5432/umami

# umami APP_SECRET（TODO: 替换为随机串，例如 openssl rand -hex 32）
APP_SECRET=change-me-random-secret
