# ===== 本地部署参数（deploy.sh 读取），复制为 .env 后填入真实值 =====
# .env 已在 .gitignore 中，不会入库

# 服务器地址（IP 或域名）
DEPLOY_HOST=your-server-ip-or-host.example.com

# SSH 登录用户
DEPLOY_USER=deploy

# 服务器上的博客静态目录（须与 deploy/docker-compose.yml 中 Caddy 挂载的宿主机路径一致，
# 例如 /home/paul/blog/public，注意结尾带 / 表示同步目录内容）
DEPLOY_PATH=/home/paul/blog/public

# SSH 端口（可选，默认 22）
DEPLOY_SSH_PORT=22

# SSH 私钥文件路径（可选）。不填则使用 ssh 默认规则（~/.ssh/id_* 或 ssh-agent）；
# 用密钥文件登录时填本机私钥路径，例如 /Users/wenchen/Documents/PaulBlog/paul-blog.pem
# DEPLOY_SSH_KEY=/path/to/your-key.pem
